<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CardVault.ViewModels"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="720"
        x:DataType="vm:SettingsViewModel"
        x:Class="CardVault.Views.SettingsWindow"
        Title="Settings"
        Width="520" Height="720" MinWidth="480" MinHeight="560"
        WindowStartupLocation="CenterOwner" CanResize="False">

    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource BrushAppBg}">

        <Grid ColumnDefinitions="*,Auto" Margin="26,22,18,0">
            <TextBlock Text="Settings" Classes="h1" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="tlink" Content="Done" Command="{Binding DoneCommand}" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="26,16,26,20">
            <StackPanel Spacing="16">

                <!-- World -->
                <Border Background="{DynamicResource BrushSurface}" CornerRadius="14" Padding="18"
                        BorderBrush="{DynamicResource BrushStroke}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="THEME" Classes="eyebrow" />
                        <TextBlock Classes="faint" TextWrapping="Wrap"
                                   Text="The whole interface re-skins instantly. Your card data is unaffected." />
                        <ComboBox ItemsSource="{Binding ThemeOptions}"
                                  SelectedItem="{Binding SelectedTheme}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ThemeOption">
                                    <StackPanel Spacing="2" Margin="0,2">
                                        <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Blurb}" FontSize="11.5"
                                                   Foreground="{DynamicResource BrushTextMuted}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Session -->
                <Border Background="{DynamicResource BrushSurface}" CornerRadius="14" Padding="18"
                        BorderBrush="{DynamicResource BrushStroke}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="SESSION" FontSize="11" FontWeight="Bold" LetterSpacing="1.6"
                                   Foreground="{DynamicResource BrushTextFaint}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Auto-lock" FontSize="14" />
                                <TextBlock Classes="faint"
                                           Text="Vault locks automatically after this much inactivity." TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="150" Margin="12,0,0,0" VerticalAlignment="Center"
                                      ItemsSource="{Binding LockOptions}"
                                      SelectedItem="{Binding SelectedLock}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LockOption">
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <Button Classes="ghost" Content="Lock now" Command="{Binding LockNowCommand}"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- Automatic backups -->
                <Border Background="{DynamicResource BrushSurface}" CornerRadius="14" Padding="18"
                        BorderBrush="{DynamicResource BrushStroke}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="AUTOMATIC BACKUPS" FontSize="11" FontWeight="Bold" LetterSpacing="1.6"
                                   Foreground="{DynamicResource BrushTextFaint}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Schedule" FontSize="14" />
                                <TextBlock Classes="faint" TextWrapping="Wrap"
                                           Text="Auto-backups reuse your master key, so they are encrypted end-to-end and can be restored with your master password anywhere." />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="150" Margin="12,0,0,0" VerticalAlignment="Center"
                                      ItemsSource="{Binding BackupCadences}"
                                      SelectedItem="{Binding SelectedBackupCadence}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BackupCadenceOption">
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Keep at most" FontSize="14" />
                                <TextBlock Classes="faint" TextWrapping="Wrap"
                                           Text="Older automatic backups are deleted once this many exist." />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="150" Margin="12,0,0,0" VerticalAlignment="Center"
                                      ItemsSource="{Binding BackupRetains}"
                                      SelectedItem="{Binding SelectedBackupRetain}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BackupRetainOption">
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Folder" FontSize="14" />
                                <TextBlock Grid.Column="0" Classes="faint" TextWrapping="Wrap"
                                           Text="{Binding BackupFolder}" MaxLines="3" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="ghost" Content="Choose…" Margin="12,0,0,0"
                                    VerticalAlignment="Center" Command="{Binding PickBackupFolderCommand}" />
                        </Grid>
                        <Button Classes="tprimary" Content="Back up now" HorizontalAlignment="Left"
                                Command="{Binding BackupNowCommand}" IsEnabled="{Binding IsBackupIdle}" />
                        <TextBlock Classes="faint" TextWrapping="Wrap" Text="{Binding BackupStatus}" LineHeight="18" />
                    </StackPanel>
                </Border>

                <!-- Sync -->
                <Border Background="{DynamicResource BrushSurface}" CornerRadius="14" Padding="18"
                        BorderBrush="{DynamicResource BrushStroke}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="SYNC ACROSS DEVICES" FontSize="11" FontWeight="Bold" LetterSpacing="1.6"
                                   Foreground="{DynamicResource BrushTextFaint}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Enable file sync" FontSize="14" />
                                <TextBlock Classes="faint" TextWrapping="Wrap"
                                           Text="Encrypted snapshot exchanged through any synced folder (Dropbox, OneDrive, network drive). No server, no accounts — both devices need the same master password." />
                            </StackPanel>
                            <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                                      IsChecked="{Binding SyncEnabled}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Shared folder" FontSize="14" />
                                <TextBlock Grid.Column="0" Classes="faint" TextWrapping="Wrap"
                                           Text="{Binding SyncFolder}" MaxLines="3" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="ghost" Content="Choose…" Margin="12,0,0,0"
                                    VerticalAlignment="Center" Command="{Binding PickSyncFolderCommand}" />
                        </Grid>
                        <Button Classes="tprimary" Content="Sync now" HorizontalAlignment="Left"
                                Command="{Binding SyncNowCommand}" IsEnabled="{Binding IsSyncIdle}" />
                        <TextBlock Classes="faint" TextWrapping="Wrap" Text="{Binding SyncStatus}" LineHeight="18" />
                    </StackPanel>
                </Border>

                <!-- Backups -->
                <Border Background="{DynamicResource BrushSurface}" CornerRadius="14" Padding="18"
                        BorderBrush="{DynamicResource BrushStroke}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="BACKUPS" FontSize="11" FontWeight="Bold" LetterSpacing="1.6"
                                   Foreground="{DynamicResource BrushTextFaint}" />
                        <Button Classes="ghost" Content="Export encrypted backup…" HorizontalAlignment="Left"
                                Command="{Binding ExportCommand}" />
                        <Button Classes="ghost" Content="Import backup…" HorizontalAlignment="Left"
                                Command="{Binding ImportCommand}" />
                        <Button Classes="ghost" Content="Import KeePass database…" HorizontalAlignment="Left"
                                Command="{Binding ImportKeepassCommand}" />
                        <Button Classes="ghost" Content="Export plain CSV…" HorizontalAlignment="Left"
                                Command="{Binding ExportCsvCommand}" />
                        <Button Classes="ghost" Content="Import CSV…" HorizontalAlignment="Left"
                                Command="{Binding ImportCsvCommand}" />
                        <TextBlock Classes="faint" TextWrapping="Wrap"
                                   Text="Backups are encrypted with AES-256-GCM and protected by a passphrase of your choice. They can be restored on this or any other CardVault installation. KeePass imports read password-protected KDBX 3.x files (groups and entries) and store them inside your vault. CSV is the one deliberately plain-text output — you will be warned before it is written." />
                    </StackPanel>
                </Border>

                <!-- Updates -->
                <Border Background="{DynamicResource BrushSurface}" CornerRadius="14" Padding="18"
                        BorderBrush="{DynamicResource BrushStroke}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="UPDATES" FontSize="11" FontWeight="Bold" LetterSpacing="1.6"
                                   Foreground="{DynamicResource BrushTextFaint}" />
                        <Button Classes="ghost" Content="Check for updates" HorizontalAlignment="Left"
                                Command="{Binding CheckForUpdatesCommand}" IsEnabled="{Binding IsUpdateIdle}" />
                        <TextBlock Classes="faint" TextWrapping="Wrap" Text="{Binding UpdateStatus}" />
                        <Button Classes="ghost" Content="Open releases page…" HorizontalAlignment="Left"
                                Command="{Binding OpenUpdatePageCommand}" IsVisible="{Binding UpdateAvailable}" />
                    </StackPanel>
                </Border>

                <!-- Master password -->
                <Border Background="{DynamicResource BrushSurface}" CornerRadius="14" Padding="18"
                        BorderBrush="{DynamicResource BrushStroke}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="MASTER PASSWORD" FontSize="11" FontWeight="Bold" LetterSpacing="1.6"
                                   Foreground="{DynamicResource BrushTextFaint}" />
                        <TextBox Classes="tcard" Watermark="Current password" PasswordChar="●"
                                     Text="{Binding OldPassword, Mode=TwoWay}" />
                        <TextBox Classes="tcard" Watermark="New password (min. 8 characters)" PasswordChar="●"
                                     Text="{Binding NewPassword, Mode=TwoWay}" />
                        <TextBox Classes="tcard" Watermark="Confirm new password" PasswordChar="●"
                                     Text="{Binding ConfirmPassword, Mode=TwoWay}" />
                        <Button Classes="tprimary" Content="Update password" HorizontalAlignment="Left"
                                Command="{Binding ChangePasswordCommand}" IsEnabled="{Binding IsIdle}" />
                    </StackPanel>
                </Border>

                <!-- Security model -->
                <Border Background="{DynamicResource BrushSurface}" CornerRadius="14" Padding="18"
                        BorderBrush="{DynamicResource BrushStroke}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="SECURITY MODEL" FontSize="11" FontWeight="Bold" LetterSpacing="1.6"
                                   Foreground="{DynamicResource BrushTextFaint}" />
                        <TextBlock Classes="faint" TextWrapping="Wrap" LineHeight="19"
                                   Text="• Every card is sealed with AES-256-GCM using a key derived from your master password (PBKDF2-HMAC-SHA256, 310,000 iterations)." />
                        <TextBlock Classes="faint" TextWrapping="Wrap" LineHeight="19"
                                   Text="• Card numbers, holder names, expiry, CVV and notes are never written to disk in plaintext — only the card label is stored as metadata in the local SQLite database." />
                        <TextBlock Classes="faint" TextWrapping="Wrap" LineHeight="19"
                                   Text="• The decrypted key lives only in memory and is zeroed the moment the vault locks." />
                        <TextBlock Classes="faint" TextWrapping="Wrap" LineHeight="19"
                                   Text="• The only network call is an optional 'Check for updates' request to the public GitHub releases page. The app never sends your data anywhere." />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="26,14,26,22">
            <Button Grid.Column="1" Classes="tprimary" Content="Done" Command="{Binding DoneCommand}" />
        </Grid>
    </Grid>
</Window>