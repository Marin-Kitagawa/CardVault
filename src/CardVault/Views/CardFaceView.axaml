<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CardVault.Views.CardFaceView"
             x:Name="Root">

    <UserControl.Resources>
        <!-- bottom legibility scrim: holds type readable on bright swatches -->
        <LinearGradientBrush x:Key="FaceScrim" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0.00" Color="#00000000" />
            <GradientStop Offset="0.44" Color="#1C000000" />
            <GradientStop Offset="0.78" Color="#44000000" />
            <GradientStop Offset="1.00" Color="#5C000000" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ChipMetal" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#FDF3C9" />
            <GradientStop Offset="0.5" Color="#E3BB66" />
            <GradientStop Offset="1" Color="#CD9F45" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <Border CornerRadius="22"
            Background="{Binding FaceBrush, ElementName=Root}"
            BorderBrush="#2EFFFFFF"
            BorderThickness="1"
            ClipToBounds="True">

        <Grid>
            <!-- material: soft table-top gloss -->
            <Grid ClipToBounds="True" IsHitTestVisible="False">
                <Ellipse Width="400" Height="260"
                         HorizontalAlignment="Right" VerticalAlignment="Top"
                         Margin="0,-180,-150,-100"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#5CFFFFFF" />
                            <GradientStop Offset="0.55" Color="#12FFFFFF" />
                            <GradientStop Offset="1" Color="#00FFFFFF" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="300" Height="240"
                         HorizontalAlignment="Left" VerticalAlignment="Bottom"
                         Margin="-130,-80,-90,-180"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#22FFFFFF" />
                            <GradientStop Offset="1" Color="#00FFFFFF" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>

            <!-- legibility scrim behind type -->
            <Border CornerRadius="22" Background="{StaticResource FaceScrim}" IsHitTestVisible="False" />

            <!-- inner print hairline -->
            <Border Margin="7" CornerRadius="15" BorderBrush="#1EFFFFFF" BorderThickness="1"
                    IsHitTestVisible="False" />

            <Grid Margin="24,22,24,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- top: chip + contactless | brand -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Top">
                        <Border Width="42" Height="30" CornerRadius="7"
                                Background="#E9C477" Opacity="0.96"
                                IsVisible="{Binding ShowChip, ElementName=Root}">
                            <Grid>
                                <Border CornerRadius="6" Background="{StaticResource ChipMetal}" Margin="1">
                                    <Path Data="M12 6 L18 10 L12 14 L18 18 L12 22 M30 6 L24 10 L30 14 L24 18 L30 22"
                                          Stroke="#B07E2F" StrokeThickness="1.3"
                                          StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent" />
                                </Border>
                            </Grid>
                        </Border>

                        <StackPanel Spacing="3" VerticalAlignment="Top" HorizontalAlignment="Left"
                                    IsVisible="{Binding ShowContactless, ElementName=Root}">
                            <Path Data="M12 20h.01 M2 8.82a15 15 0 0 1 20 0 M5 12.859a10 10 0 0 1 14 0 M8.5 16.429a5 5 0 0 1 7 0"
                                  Stroke="{Binding FaceForeground, ElementName=Root}" StrokeThickness="1.7"
                                  StrokeLineCap="Round" StrokeJoin="Round"
                                  Fill="Transparent" Width="24" Height="24" Stretch="Uniform" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="2" CornerRadius="9" Padding="9,5,9,5"
                            Background="{Binding BrandPillBackground, ElementName=Root}"
                            VerticalAlignment="Top"
                            IsVisible="{Binding BrandText, ElementName=Root, Converter={StaticResource NonEmptyToVis}}">
                        <TextBlock Text="{Binding BrandText, ElementName=Root}"
                                   Foreground="{Binding FaceForeground, ElementName=Root}"
                                   FontWeight="Bold" FontSize="12" LetterSpacing="2" />
                    </Border>
                </Grid>

                <!-- number -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="10">
                    <TextBlock Text="{Binding NumberText, ElementName=Root}"
                               IsVisible="{Binding NumberText, ElementName=Root, Converter={StaticResource NonEmptyToVis}}"
                               FontFamily="{DynamicResource FontDigits}"
                               FontSize="21" FontWeight="Bold" LetterSpacing="1.4"
                               Foreground="{Binding FaceForeground, ElementName=Root}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- bottom: name / expiry -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="3" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding CardNameText, ElementName=Root}"
                                   IsVisible="{Binding CardNameText, ElementName=Root, Converter={StaticResource NonEmptyToVis}}"
                                   FontSize="15.5" FontWeight="SemiBold"
                                   Foreground="{Binding FaceForeground, ElementName=Root}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="230" />
                        <TextBlock Text="{Binding HolderText, ElementName=Root}"
                                   IsVisible="{Binding HolderText, ElementName=Root, Converter={StaticResource NonEmptyToVis}}"
                                   FontSize="12" Opacity="0.62"
                                   Foreground="{Binding FaceForeground, ElementName=Root}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="230" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                        <TextBlock Text="VALID THRU" FontSize="9" LetterSpacing="1.4" Opacity="0.46"
                                   Foreground="{Binding FaceForeground, ElementName=Root}"
                                   IsVisible="{Binding ExpiryText, ElementName=Root, Converter={StaticResource NonEmptyToVis}}" />
                        <TextBlock Text="{Binding ExpiryText, ElementName=Root}"
                                   IsVisible="{Binding ExpiryText, ElementName=Root, Converter={StaticResource NonEmptyToVis}}"
                                   FontSize="12.5" FontWeight="Bold"
                                   Foreground="{Binding FaceForeground, ElementName=Root}"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>