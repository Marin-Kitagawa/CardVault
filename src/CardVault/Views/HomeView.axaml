<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CardVault.ViewModels"
             xmlns:views="clr-namespace:CardVault.Views"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="720"
             x:DataType="vm:HomeViewModel"
             x:Class="CardVault.Views.HomeView">

    <Grid Background="{DynamicResource BrushAppBg}" ColumnDefinitions="264,*">

        <!-- ===== sidebar: folders ===== -->
        <Border Grid.Column="0" Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushStroke}" BorderThickness="0,0,1,0"
                Margin="0" Padding="0">
            <Grid RowDefinitions="Auto,Auto,*" Margin="18,26,18,18">

                <!-- all items -->
                <Button Classes="kindopt" Command="{Binding ShowAllCommand}" Padding="0" Margin="0,0,0,10">
                    <Grid ColumnDefinitions="Auto,*" Margin="12,9">
                        <Border Width="34" Height="34" CornerRadius="17"
                                Background="{DynamicResource BrushSurfaceHigh}"
                                BorderBrush="{DynamicResource BrushStroke}" BorderThickness="1">
                            <Path Data="M3 7h18 M3 12h18 M3 17h18 M8 5v2 M8 10v2 M8 15v2"
                                  Stroke="{DynamicResource BrushAccent}" StrokeThickness="1.7"
                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                  Width="16" Height="16" Stretch="Uniform" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="All items" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>
                </Button>

                <!-- folder tree -->
                <ScrollViewer Grid.Row="2">
                    <StackPanel Spacing="2">
                        <Grid ColumnDefinitions="*,Auto" Margin="4,0,0,8">
                            <TextBlock Text="FOLDERS" Classes="eyebrow" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                <Button Classes="icon" Command="{Binding AddFolderCommand}" Margin="0"
                                        ToolTip.Tip="New folder">
                                    <Path Data="M5 12h14 M12 5v14" Stroke="{DynamicResource BrushTextMuted}"
                                          StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                          Fill="Transparent" Width="14" Height="14" Stretch="Uniform" />
                                </Button>
                                <Button Classes="icon" Command="{Binding ManageFoldersCommand}" Margin="0"
                                        ToolTip.Tip="Manage folders">
                                    <Path Data="M4 4h6a2 2 0 0 1 2 2v6H4z M14 4h6v6h-6z M4 14h6v6H4z M14 14h6v6h-6z"
                                          Stroke="{DynamicResource BrushTextMuted}" StrokeThickness="1.6"
                                          StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                          Width="14" Height="14" Stretch="Uniform" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding FolderTree}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FolderNodeViewModel">
                                    <Border CornerRadius="10" Padding="{Binding Indent}" Margin="0,1"
                                            Classes.selected="{Binding IsSelected}">
                                        <Border.Styles>
                                            <Style Selector="Border.selected">
                                                <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
                                            </Style>
                                        </Border.Styles>
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                            <Button Classes="icon" Command="{Binding ToggleCommand}"
                                                    IsVisible="{Binding IsExpandable}" Margin="0"
                                                    Width="22" Height="22" Padding="0">
                                                <TextBlock Text="{Binding Chevron}" FontSize="11"
                                                           Foreground="{DynamicResource BrushTextMuted}"
                                                           VerticalAlignment="Center" />
                                            </Button>
                                            <Path Grid.Column="1" Data="{Binding Icon}"
                                                  Stroke="{DynamicResource BrushTextMuted}" StrokeThickness="1.6"
                                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                                  Width="17" Height="17" Stretch="Uniform" Margin="2,0,8,0"
                                                  VerticalAlignment="Center" />
                                            <Button Grid.Column="2" Classes="tlink" Padding="0"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Command="{Binding SelectCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="6"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13.5"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding CountText}" Classes="faint"
                                                               FontSize="11" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ===== wallet ===== -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <Grid RowDefinitions="Auto,Auto" Margin="30,26,30,12">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3">
                        <TextBlock Text="CardVault" FontFamily="{DynamicResource FontDisplay}" FontSize="28" FontWeight="Bold" />
                        <TextBlock Text="{Binding Subtitle}" Classes="muted" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button Classes="ghost" Command="{Binding LockCommand}" Content="Lock" />
                        <Button Classes="ghost" Command="{Binding OpenSettingsCommand}" Content="Settings" />
                    </StackPanel>
                </Grid>
                <TextBox Grid.Row="1" Margin="0,14,0,0" Classes="tsearch"
                         Watermark="Search name, kind, brand or tag."
                         Text="{Binding SearchText, Mode=TwoWay}" />
            </Grid>

            <ScrollViewer Grid.Row="1" Margin="22,8,22,96">
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:EntryTileViewModel">
                            <Button Classes="tcardtile" Command="{Binding OpenCommand}" Margin="11">
                                <Grid>

                                    <!-- card tile -->
                                    <views:CardFaceView Width="300" Height="189" IsVisible="{Binding IsCard}"
                                                        CardNameText="{Binding Name}"
                                                        BrandText="{Binding BrandLabel}"
                                                        ColorStart="{Binding ColorStart}"
                                                        ColorEnd="{Binding ColorEnd}" />

                                    <!-- generic pocket tile -->
                                    <Border Width="300" Height="189" CornerRadius="22"
                                            Background="{DynamicResource BrushSurface}"
                                            BorderBrush="{DynamicResource BrushStroke}" BorderThickness="1"
                                            IsVisible="{Binding IsCard, Converter={StaticResource InverseBool}}">
                                        <Grid Margin="22,18" RowDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Row="0" Text="{Binding KindName}" Classes="eyebrow"
                                                       Foreground="{DynamicResource BrushAccent}" />
                                            <Border Grid.Row="1" Width="56" Height="56" CornerRadius="28"
                                                    Background="{DynamicResource BrushSurfaceHigh}"
                                                    BorderBrush="{DynamicResource BrushStroke}" BorderThickness="1"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Path Data="{Binding Icon}" Stroke="{DynamicResource BrushAccent}"
                                                      StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                                                      Fill="Transparent" Width="26" Height="26" Stretch="Uniform" />
                                            </Border>
                                            <StackPanel Grid.Row="2" Spacing="3">
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding TagsText}" Classes="muted" FontSize="11"
                                                           Opacity="0.8" TextTrimming="CharacterEllipsis"
                                                           IsVisible="{Binding TagsText, Converter={StaticResource NonEmptyToVis}}" />
                                                <TextBlock Text="          " Classes="muted" FontSize="12"
                                                           Opacity="0.7" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- empty state -->
            <StackPanel Grid.Row="1" IsVisible="{Binding ShowEmpty}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="12" Margin="0,0,0,50">
                <Border Width="92" Height="92" CornerRadius="46"
                        Background="{DynamicResource BrushSurfaceAlt}" HorizontalAlignment="Center">
                    <Path Data="M18 8h1a4 4 0 0 1 4 4v8a4 4 0 0 1-4 4H5a4 4 0 0 1-4-4v-8a4 4 0 0 1 4-4h1 M6 8V7a6 6 0 0 1 12 0v1 M12 11v5"
                          Stroke="{DynamicResource BrushAccent}" StrokeThickness="2"
                          StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                          Width="60" Height="60" Stretch="Uniform" Margin="16,16,16,16" />
                </Border>
                <TextBlock Text="{Binding EmptyTitle}" Classes="h2" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding EmptyBlurb}" Classes="muted" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" />
                <Button Classes="tprimary" Content="{Binding AddButtonLabel}" Command="{Binding AddEntryCommand}"
                        HorizontalAlignment="Center" />
            </StackPanel>

            <!-- add button -->
            <Button Grid.Row="1" Classes="fab"
                    Command="{Binding AddEntryCommand}"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,30">
                <Path Data="M5 12h14 M12 5v14"
                      Stroke="{DynamicResource BrushOnAccent}" StrokeThickness="2.4"
                      StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                      Width="28" Height="28" Stretch="Uniform" />
            </Button>
        </Grid>
    </Grid>
</UserControl>