<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:CardVault.Views"
        xmlns:vm="clr-namespace:CardVault.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="720"
        x:DataType="vm:MainWindowViewModel"
        x:Class="CardVault.Views.MainWindow"
        Title="CardVault"
        Width="1080" Height="720" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid IsVisible="{Binding IsLocked}">
            <views:SetupView DataContext="{Binding Setup}" />
        </Grid>
        <Grid IsVisible="{Binding IsUnlocked}">
            <views:HomeView DataContext="{Binding Home}" />
        </Grid>
    </Grid>
</Window>